# ─────────────────────────────────────────────────────────────
# XYP (ХУР) холболтын тохиргоо — энэ файлыг .env болгож хуулаад бөглөнө
# cp .env.example .env   (эсвэл Windows дээр: copy .env.example .env)
# ─────────────────────────────────────────────────────────────

# Байгууллагад олгогдсон хандах токен
XYP_ACCESS_TOKEN=REPLACE_WITH_YOUR_ACCESS_TOKEN

# RSA хувийн түлхүүрийн зам (гарын үсэг зурахад ашиглана)
# PEM эсвэл DER формат. Үүнийг git-д ХЭЗЭЭ Ч оруулж болохгүй.
XYP_PRIVATE_KEY_PATH=./keys/private.pem

# Хэрэв түлхүүрт нууц үг (passphrase) тавьсан бол
XYP_PRIVATE_KEY_PASSPHRASE=

# Host ба хувилбар — endpoint бүр: <host>/<domain>-<version>/ws
XYP_HOST=https://xyp.gov.mn
XYP_VERSION=1.5.0

# Live тестэд ашиглах домэйн (citizen | insurance | transport | statistic | ...)
XYP_DOMAIN=citizen

# TLS: MN CA сертификатуудыг суулгасан бол хоосон орхи.
# Суулгаагүй үед PEM багц CA файлын зам өгч болно:
XYP_CA_FILE=

# TLS шалгалтыг УНТРААХ (ЗӨВХӨН локал тест/дибаг). Production дээр хэзээ ч 1 болгож болохгүй.
XYP_INSECURE_TLS=0
